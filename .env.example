# ---- Discord ----
BOT_TOKEN=
# Comma-separated Discord user IDs allowed to run owner commands.
BOT_OWNER_IDS=
# Comma-separated guild IDs where owner-only slash commands are registered (your dev/staff server).
DEV_GUILD_IDS=
# Optional channel ID that receives join/leave/owner-change reports.
REPORTING_CHANNEL=

# ---- Local MongoDB (compose.yml) ----
# Use long random URL-safe values, e.g.:  openssl rand -hex 32
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=antaresbot
MONGO_APP_PASSWORD=
# Set automatically by compose.yml for the bot container. Only set this yourself when
# running the bot outside Docker (npm run dev) against the container's localhost port:
# BOT_MONGO_PATH=mongodb://antaresbot:<MONGO_APP_PASSWORD>@127.0.0.1:27017/antaresbot?authSource=antaresbot

# ---- Optional integrations ----
NASA_API_KEY=
# Enables /confess. 32+ random chars (openssl rand -hex 32). NEVER change it once used:
# it's what lets moderators block an anonymous confessor without knowing who they are.
CONFESSION_SECRET=

# ---- Web dashboard (optional: docker compose --profile dashboard up -d) ----
# Developer Portal -> OAuth2: copy the Client ID/Secret and add the redirect
#   <DASHBOARD_PUBLIC_URL>/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_PUBLIC_URL=https://antaresbot.example.com
# openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
# true when behind your reverse proxy; the port binds to 127.0.0.1 unless DASHBOARD_BIND is set
DASHBOARD_TRUST_PROXY=true
# Full Uptime Kuma push URL, e.g. https://status.example.com/api/push/abc123
UPTIME_KUMA_PUSH_URL=
# Extra root CA for a TLS-inspecting proxy (Cloudflare Gateway, Zscaler, ...): put it at certs/extra-ca.pem
# and set this to /certs/extra-ca.pem. Leave empty otherwise.
NODE_EXTRA_CA_CERTS=
TOP_GG_TOKEN=
DISCORD_BOTS_GG_TOKEN=

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
