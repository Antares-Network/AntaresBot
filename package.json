{
  "name": "antaresbot",
  "version": "2.0.0",
  "private": true,
  "description": "A small Discord bot with a bunch of fun commands to get cute images of animals or answer your deepest question with 8ball nonsense.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antares-Network/AntaresBot.git"
  },
  "author": "Nate Goldsborough",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Antares-Network/AntaresBot/issues"
  },
  "homepage": "https://github.com/Antares-Network/AntaresBot#readme",
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@sapphire/framework": "5.5.1",
    "@sapphire/plugin-logger": "4.1.0",
    "an-array-of-english-words": "2.0.0",
    "discord.js": "14.28.1",
    "fastify": "5.12.8",
    "mongoose": "9.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "mongodb-memory-server": "11.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
